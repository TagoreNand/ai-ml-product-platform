# ---- Service ----
APP_NAME=Pulse360 Product Intelligence API
ENVIRONMENT=dev

# ---- Artifacts / registry ----
MODEL_ARTIFACT_DIR=artifacts

# ---- Modelling ----
RANDOM_SEED=42
CHURN_MODEL_TYPE=hist_gbdt           # logreg | hist_gbdt | xgboost
CHURN_CALIBRATION=isotonic           # sigmoid | isotonic | none
RECOMMENDATION_MODEL_TYPE=random_forest
ENABLE_SHAP=true

# ---- Copilot ----
COPILOT_USE_MOCK=true

# ---- Logging / observability ----
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true
REQUEST_ID_HEADER=X-Request-ID

# ---- API security / limits ----
# Leave API_KEY empty to disable auth (local dev). Set it to require the header.
API_KEY=
API_KEY_HEADER=X-API-Key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOW_ORIGINS=*
MAX_BATCH_SIZE=500

# ---- Extensions ----
DATA_SOURCE=synthetic                 # synthetic | file | sql
DATA_PATH=                            # path to CSV/Parquet/JSON when DATA_SOURCE=file
DATA_SQL_PATH=                        # sqlite db path when DATA_SOURCE=sql
DATA_SQL_QUERY=SELECT * FROM accounts
FEATURE_STORE_DIR=feature_store
EXPERIMENT_SALT=pulse360
FEEDBACK_LOG_PATH=feedback/feedback_log.jsonl
LLM_PROVIDER=mock                     # mock | openai | anthropic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
SHADOW_ENABLED=false
CANARY_PERCENT=0.0
